# ─── Dockerfile.Agent ───────────────────────────────────────────────────────
# Builds a selective agent image. The agent package name is provided as a
# build-arg AGENT_PACKAGE (e.g., agent_langgraph_copilot or adk_spark).
# Optional build args:
#   AGENT_PACKAGE — Python package under src/agentmesh/agents to include
#   DEPENDENCY_GROUP — pyproject.toml group to install (agent-langgraph, agent-adk)
#
# Usage:
#   docker build \
#     --build-arg AGENT_PACKAGE=agent_langgraph_copilot \
#     --build-arg DEPENDENCY_GROUP=agent-langgraph \
#     -f deployment/docker/Dockerfile.Agent .
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim AS base

ARG AGENT_PACKAGE=agent_langgraph_copilot
ARG DEPENDENCY_GROUP=agent-langgraph

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src \
    AGENT_PACKAGE=${AGENT_PACKAGE}

WORKDIR /app

# Install dependencies (cached layer)
COPY pyproject.toml ./
RUN pip install --upgrade "pip>=25.1" \
    && pip install --group "${DEPENDENCY_GROUP}"

# Copy source tree and install package
COPY src ./src
RUN pip install --no-deps --no-build-isolation .

# Default command: run the agent app module inside the selected agent package.
# We use a shell command so the AGENT_PACKAGE env var is expanded at runtime.
CMD ["sh", "-c", "uvicorn agentmesh.agents.${AGENT_PACKAGE}.app:app --host 0.0.0.0 --port ${PORT:-8101}"]
