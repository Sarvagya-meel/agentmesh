FROM python:3.11-slim

ARG DEPENDENCY_GROUP=control-plane

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --upgrade "pip>=25.1" \
    && pip install --group "${DEPENDENCY_GROUP}"

COPY src ./src
RUN pip install -e . --no-deps

CMD ["uvicorn", "agentmesh.services.agentmesh_server.app:app", "--host", "0.0.0.0", "--port", "8000"]
