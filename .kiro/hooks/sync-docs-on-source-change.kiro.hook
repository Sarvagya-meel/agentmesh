{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "Watches Python source files, config files, and other relevant project files. When changes are detected, asks the agent to update README.md and/or the /docs folder to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.py",
      "scripts/**/*.py",
      "pyproject.toml",
      "deployment/**/*.yml",
      "deployment/**/*.yaml",
      ".env.example"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just modified. Review the change and determine if any documentation needs to be updated. If the change affects public APIs, architecture, configuration, dependencies, agent behavior, or usage patterns, update the relevant sections in README.md and/or the appropriate file(s) under the /docs folder. Focus on keeping docs accurate and concise — do not add padding or rewrite sections that are still correct."
  }
}
