APP_NAME=AgentMesh
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://agentmesh:agentmesh@localhost:5432/agentmesh
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=2.0
AGENTMESH_API_URL=http://127.0.0.1:8000
WORKER_HEARTBEAT_SECONDS=60
WORKER_LEASE_SECONDS=300
WORKER_REQUEST_TIMEOUT_SECONDS=30
REGISTRY_BACKEND=memory

# Orchestrator checkpoints: memory for local development, postgres for durable runs
EVENT_STORE_BACKEND=memory
ORCHESTRATOR_CHECKPOINT_BACKEND=memory

# Orchestrator planning model. Keep secrets only in the ignored root .env file.
# Options: mock | groq
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=medium
GROQ_TEMPERATURE=0.1
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_TIMEOUT_SECONDS=45

# Reserved for the optional AWS model adapter.
BEDROCK_MODEL_ID=

# AWS Agent Registry — disabled by default
# Set to true only when you have AWS credentials and want to sync agent metadata
AWS_AGENT_REGISTRY_ENABLED=false
AGENT_REGISTRY_ID=

# AWS AgentCore Runtime — disabled by default
# Set to true only when you want to deploy a selected agent to AgentCore
AWS_AGENTCORE_ENABLED=false

# AWS Region — only used when AWS integrations are enabled
AWS_REGION=us-east-1
